# AgentShield production settings. setup_ec2.sh copies this to .env and fills
# every secret with a random value. Edit the three marked lines yourself.
# Never commit .env. Keep it chmod 600.

# ---- EDIT: public address and image owner ----
DOMAIN=your-name.duckdns.org
IMAGE_OWNER=your-github-username

# ---- EDIT: database. Amazon RDS PostgreSQL, TLS with certificate verification ----
# Use an alphanumeric DB password (or URL-encode special characters).
DATABASE_URL=postgres://aegis_admin:CHANGE_ME@your-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/aegis?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem

# ---- EDIT: Groq (AI policy generator + agent console) ----
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=openai/gpt-oss-20b

# ---- Generated by setup_ec2.sh (random, 64 hex characters each) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN=
GATEWAY_JWT_SECRET=
SESSION_SECRET=
TOOL_SHARED_SECRET=
REDIS_PASSWORD=
POSTGRES_PASSWORD=

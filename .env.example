# Local development settings. Copy to .env if you want to override defaults.
# For the AWS server, use deploy/.env.example instead (setup_ec2.sh generates it).
GATEWAY_JWT_SECRET=dev-jwt-secret-change-me
ADMIN_TOKEN=dev-admin-token
TOOL_SHARED_SECRET=dev-tool-secret-change-me
SESSION_SECRET=dev-session-secret-change-me
# Dashboard login (development default is admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional backends (unset = file audit log + in-memory sessions):
# DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
GATEWAY_PROFILE=full
# Groq (AI policy generator + agent console)
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=openai/gpt-oss-20b
